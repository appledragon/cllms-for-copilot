{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "useTabs": true,
  "overrides": [
    {
			"files": ["test/**/*.ts"],
      "options": {
        "singleQuote": false,
        "useTabs": false
      }
    }
  ],
  "ignorePatterns": []
}
