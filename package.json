{
  "name": "cllms-for-copilot",
  "displayName": "CLLMs for Copilot Chat",
  "description": "Pick Qwen, GLM (z.ai), MiniMax, Xiaomi MiMo, Moonshot Kimi, and Tencent Hunyuan models from the Copilot Chat model picker. Vision, thinking mode, agent tools — zero config, BYOK.",
  "icon": "resources/icon.png",
  "version": "0.1.9",
  "publisher": "CuiLiAn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/appledragon/cllms-for-copilot"
  },
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=24"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "qwen",
    "glm",
    "z.ai",
    "zhipu",
    "minimax",
    "xiaomi",
    "mimo",
    "moonshot",
    "kimi",
    "copilot",
    "github copilot",
    "copilot chat",
    "vision",
    "byok",
    "language model",
    "thinking",
    "reasoning",
    "ai",
    "chat"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "enabledApiProposals": [],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "cllms",
        "displayName": "CLLMs"
      }
    ],
    "languageModelTools": [
      {
        "name": "cllms_readImage",
        "displayName": "%cllms.tool.readImage.displayName%",
        "modelDescription": "%cllms.tool.readImage.modelDescription%",
        "description": "%cllms.tool.readImage.description%",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "%cllms.tool.readImage.inputSchema.filePath.description%"
            },
            "prompt": {
              "type": "string",
              "description": "%cllms.tool.readImage.inputSchema.prompt.description%"
            }
          },
          "required": [
            "filePath"
          ]
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cllms",
          "title": "CLLMs",
          "icon": "resources/cllms-activity.svg"
        }
      ]
    },
    "views": {
      "cllms": [
        {
          "id": "cllms.providers",
          "name": "%cllms.view.providers.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "cllms.setupProvider",
        "title": "%cllms.command.setupProvider%",
        "icon": "$(wand)"
      },
      {
        "command": "cllms.setApiKey",
        "title": "%cllms.command.setApiKey%"
      },
      {
        "command": "cllms.getApiKey",
        "title": "%cllms.command.getApiKey%"
      },
      {
        "command": "cllms.clearApiKey",
        "title": "%cllms.command.clearApiKey%"
      },
      {
        "command": "cllms.setVisionModel",
        "title": "%cllms.command.setVisionModel%",
        "icon": "$(eye)"
      },
      {
        "command": "cllms.testConnection",
        "title": "%cllms.command.testConnection%"
      },
      {
        "command": "cllms.showSessionCost",
        "title": "%cllms.command.showSessionCost%"
      },
      {
        "command": "cllms.configureUtilityModel",
        "title": "%cllms.command.configureUtilityModel%"
      },
      {
        "command": "cllms.openSettings",
        "title": "%cllms.command.openSettings%"
      },
      {
        "command": "cllms.openProviderSettings",
        "title": "%cllms.command.openProviderSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cllms.showLogs",
        "title": "%cllms.command.showLogs%"
      },
      {
        "command": "cllms.openRequestDumpsFolder",
        "title": "%cllms.command.openRequestDumpsFolder%"
      },
      {
        "command": "cllms.copyDiagnosticReport",
        "title": "%cllms.command.copyDiagnosticReport%",
        "icon": "$(copy)"
      },
      {
        "command": "cllms.openWalkthrough",
        "title": "%cllms.command.openWalkthrough%",
        "icon": "$(book)"
      },
      {
        "command": "cllms.providers.refresh",
        "title": "%cllms.command.providers.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "cllms.providers.setupProvider",
        "title": "%cllms.command.providers.setupProvider%",
        "icon": "$(wand)"
      },
      {
        "command": "cllms.providers.setApiKey",
        "title": "%cllms.command.providers.setApiKey%",
        "icon": "$(key)"
      },
      {
        "command": "cllms.providers.clearApiKey",
        "title": "%cllms.command.providers.clearApiKey%",
        "icon": "$(trash)"
      },
      {
        "command": "cllms.providers.testConnection",
        "title": "%cllms.command.providers.testConnection%",
        "icon": "$(plug)"
      },
      {
        "command": "cllms.providers.openApiKeyPage",
        "title": "%cllms.command.providers.openApiKeyPage%",
        "icon": "$(link-external)"
      },
      {
        "command": "cllms.providers.openUsagePage",
        "title": "%cllms.command.providers.openUsagePage%",
        "icon": "$(graph)"
      },
      {
        "command": "cllms.providers.openStatusPage",
        "title": "%cllms.command.providers.openStatusPage%",
        "icon": "$(pulse)"
      },
      {
        "command": "cllms.providers.openSettings",
        "title": "%cllms.command.providers.openSettings%",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cllms.providers.refresh",
          "when": "false"
        },
        {
          "command": "cllms.providers.setupProvider",
          "when": "false"
        },
        {
          "command": "cllms.providers.setApiKey",
          "when": "false"
        },
        {
          "command": "cllms.providers.clearApiKey",
          "when": "false"
        },
        {
          "command": "cllms.providers.testConnection",
          "when": "false"
        },
        {
          "command": "cllms.providers.openApiKeyPage",
          "when": "false"
        },
        {
          "command": "cllms.providers.openUsagePage",
          "when": "false"
        },
        {
          "command": "cllms.providers.openStatusPage",
          "when": "false"
        },
        {
          "command": "cllms.providers.openSettings",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "cllms.providers.refresh",
          "when": "view == cllms.providers",
          "group": "navigation@1"
        },
        {
          "command": "cllms.setVisionModel",
          "when": "view == cllms.providers",
          "group": "navigation@2"
        },
        {
          "command": "cllms.openSettings",
          "when": "view == cllms.providers",
          "group": "1_config@1"
        },
        {
          "command": "cllms.openProviderSettings",
          "when": "view == cllms.providers",
          "group": "1_config@2"
        },
        {
          "command": "cllms.showLogs",
          "when": "view == cllms.providers",
          "group": "1_config@3"
        },
        {
          "command": "cllms.copyDiagnosticReport",
          "when": "view == cllms.providers",
          "group": "1_config@4"
        },
        {
          "command": "cllms.openWalkthrough",
          "when": "view == cllms.providers",
          "group": "1_config@5"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "cllmsGettingStarted",
        "title": "%cllms.walkthrough.title%",
        "description": "%cllms.walkthrough.description%",
        "steps": [
          {
            "id": "advancedSettings",
            "title": "%cllms.walkthrough.advancedSettings.title%",
            "description": "%cllms.walkthrough.advancedSettings.description%",
            "media": {
              "markdown": "advanced-settings.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%cllms.config.title%",
      "properties": {
        "cllms.baseUrl": {
          "type": "string",
          "default": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "description": "%cllms.config.baseUrl.description%"
        },
        "cllms.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%cllms.config.maxTokens.description%"
        },
        "cllms.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "markdownDescription": "%cllms.config.maxRetries.description%"
        },
        "cllms.experimental.stabilizeToolList": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cllms.config.experimental.stabilizeToolList.description%",
          "tags": [
            "experimental"
          ]
        },
        "cllms.experimental.sortToolsForCache": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cllms.config.experimental.sortToolsForCache.description%",
          "tags": [
            "experimental"
          ]
        },
        "cllms.experimental.replayReasoningScope": {
          "type": "string",
          "default": "all",
          "enum": [
            "all",
            "latest-tool-loop"
          ],
          "enumDescriptions": [
            "%cllms.config.experimental.replayReasoningScope.all%",
            "%cllms.config.experimental.replayReasoningScope.latestToolLoop%"
          ],
          "markdownDescription": "%cllms.config.experimental.replayReasoningScope.description%",
          "tags": [
            "experimental"
          ]
        },
        "cllms.visionProxy.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 120000,
          "markdownDescription": "%cllms.config.visionProxy.timeoutMs.description%"
        },
        "cllms.utility.maxOutputTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%cllms.config.utility.maxOutputTokens.description%"
        },
        "cllms.utility.modelIdByProvider": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "qwen": {
              "type": "string"
            },
            "qwen-intl": {
              "type": "string"
            },
            "zai": {
              "type": "string"
